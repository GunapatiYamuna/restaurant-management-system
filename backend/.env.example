DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
ALLOW_ADMIN_REGISTRATION=True
RUN_PUSH_SCHEDULER_IN_WEB=True

# Railway MySQL can use either MYSQL_* names below or Railway's
# MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE variables.
MYSQL_DATABASE=foodiehub_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

EMAIL_HOST_USER=your_gmail_address@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
FRONTEND_BASE_URL=http://127.0.0.1:8000

# Google Identity Services web client ID
GOOGLE_CLIENT_ID=

# Browser Web Push / VAPID.
# In production, keep the private key stable across deployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_B64=
VAPID_CLAIMS_EMAIL=mailto:your-email@example.com

# The current project uses the demo/simulated payment flow.
# Razorpay variables are optional and should remain empty unless you
# intentionally enable the real Razorpay integration.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
